#Options
GenerateScanner = true
GenerateParser = false
Language = Java
ScannerName = Lexico
ScannerCaseSensitive = true
ScannerTable = Compact
Input = Stream
#RegularDefinitions

  min: [a-z]
  mai: [A-Z]
  digito: [0-9]
  prefixo: (i|f|b|s)_
  letra: {min} | {mai}
  digs: [1-9]
#Tokens


	// palavra reservada

	pr: {min} ({letra})*


	// identificador (:!)

	id:! {prefixo} ({min} ({mai})? | {mai}) (({min} | {digito})+ ({mai})?)*


	// cte_int

	int: ({digs} ({digito})*) | 0


	// cte_float
	
	float: (({digs} ({digito})*) | 0 ) "," ((({digito})* {digs}) | 0)


	// cte_string

	string: \"(([^\"\n%]) | (%x))*\"

	main = pr: "main"
	end = pr: "end"
	if = pr: "if"
	elif = pr: "elif"
	else = pr: "else"
	false = pr: "false"
	true = pr: "true"
	read = pr: "read"
	write = pr: "write"
	writeln = pr: "writeln"
	repeat = pr: "repeat"
	until = pr: "until"
	while = pr: "while"


	// comentário bloco

	:! >@ \n [^@]* \n @<
 

	// símbolos especiais

	"&&"
	"||"
	"!"
	"=="
	"!="
	">"
	"<"
	"+"
	"-"
	"*"
	"/"
	","
	";"
	"="
	"("
	")"

	// caracteres de formatação

	:[\s\t\n]


